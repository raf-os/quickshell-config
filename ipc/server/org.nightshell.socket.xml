<!DOCTYPE node PUBLIC "-//freedesktop//DTD D-BUS Object Introspection 1.0//EN" "http://www.freedesktop.org/standards/dbus/1.0/introspect.dtd">
<node>
  <interface name="org.nightshell.socket">
    <method name="ChangeWallpaper">
      <arg name="path" type="s" direction="in" />
      <arg name="fillMode" type="s" direction="in" />
      <arg name="success" type="b" direction="out" />
    </method>
    <method name="AppendWallpaper">
      <arg name="path" type="s" direction="in" />
      <arg name="fillMode" type="s" direction="in" />
      <arg name="duration" type="i" direction="in" />
      <arg name="success" type="b" direction="out" />
    </method>
    <method name="AppendWallpaperDialog">
      <arg name="path" type="s" direction="in" />
      <arg name="success" type="b" direction="out" />
    </method>
    <method name="NextWallpaper">
      <arg name="success" type="b" direction="out" />
    </method>
    <method name="ToggleLauncher">
      <arg name="success" type="b" direction="out" />
    </method>
    <method name="OpenLauncher">
      <arg name="success" type="b" direction="out" />
    </method>
    <signal name="WallpaperChanged">
      <arg name="path" type="s" direction="out" />
    </signal>
  </interface>
</node>
